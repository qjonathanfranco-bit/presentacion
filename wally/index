<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DeporZone - Arena & Reservas Pro</title>
    <link rel="stylesheet" href="styles.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>

    <!-- Barra de Navegación Deportiva -->
    <header class="navbar">
        <div class="logo">⚡ <span>DEPOR</span>ZONE 🏟️</div>
        <div class="menu-toggle" id="mobile-menu">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <ul class="nav-list">
            <li><a href="#" class="nav-link active" data-section="wally">🏐 Wallys Pro</a></li>
            <li><a href="#" class="nav-link" data-section="futsal">⚽ Futsal Arena</a></li>
            <li><a href="#" class="nav-link" data-section="voley">🏐 Vóley Master</a></li>
            <li><button id="theme-toggle" class="theme-btn">🌙 Modo Oscuro</button></li>
        </ul>
    </header>

    <!-- Contenido Principal -->
    <main class="main-container">
        
        <!-- ================= SECCIÓN DE WALLY ================= -->
        <section id="wally" class="content-section theme-wally">
            <div class="sport-container">
                <div class="accordion-btn">🏐 <span>ARENA WALLY</span> - Panel de Control</div>
                
                <div class="accordion-panel">
                    
                    <!-- Datos de Fecha y Hora de Reserva -->
                    <div class="reserva-meta-box">
                        <div class="meta-field">
                            <label>📅 Fecha de Partido:</label>
                            <input type="date" id="fecha-wally">
                        </div>
                        <div class="meta-field">
                            <label>⏰ Hora de Inicio:</label>
                            <input type="time" id="hora-wally">
                        </div>
                    </div>

                    <!-- Canchas A, B, C con Imágenes Grandes -->
                    <div class="canchas-grid">
                        <div class="cancha-card selected" data-cancha="Cancha A" data-precio="40">
                            <div class="badge-sport">🏐 Wally A</div>
                            <img src="img/vol/A.jpeg" alt="Cancha A">
                            <h4>Cancha A</h4>
                            <p>Sintética Techada</p>
                        </div>
                        <div class="cancha-card" data-cancha="Cancha B" data-precio="45">
                            <div class="badge-sport">🏐 Wally B</div>
                            <img src="img/vol/B.jpeg" alt="Cancha B">
                            <h4>Cancha B</h4>
                            <p>Paredes de Blindex</p>
                        </div>
                        <div class="cancha-card" data-cancha="Cancha C" data-precio="50">
                            <div class="badge-sport">🏐 Wally C</div>
                            <img src="img/vol/C.jpeg" alt="Cancha C">
                            <h4>Cancha C</h4>
                            <p>Panorámica Pro</p>
                        </div>
                    </div>

                    <!-- Configuración de Precio Manual -->
                    <div class="config-precio">
                        <label>💵 Precio Total del Ambiente (Bs):</label>
                        <input type="number" id="input-precio-wally" value="40" min="10" step="5">
                    </div>

                    <div class="info-box">
                        <p><strong>Cancha Elegida:</strong> <span id="lbl-cancha-wally">Cancha A</span></p>
                        <p><strong>Cupos Ocupados:</strong> <span id="total-jugadores-wally">0</span> / 16 (Máx.)</p>
                        <p><strong>Cuota por Jugador:</strong> <span id="cuota-persona-wally">0.00</span> Bs</p>
                    </div>

                    <div class="input-group">
                        <input type="text" id="nombre-jugador-wally" placeholder="Nombre del integrante..." maxlength="30">
                        <button id="btn-anotar-wally">➕ Añadir a Lista</button>
                    </div>

                    <ul id="lista-jugadores-wally" class="player-list"></ul>

                    <!-- Pagos y QR -->
                    <div class="payment-section">
                        <h3>💳 Métodos de Pago Habilitados</h3>
                        <div class="payment-options">
                            <button class="pay-btn" data-sport="wally" data-method="qr">📲 Pagar con QR Bancario</button>
                            <button class="pay-btn" data-sport="wally" data-method="efectivo">💵 Efectivo en Cancha</button>
                        </div>
                        <div id="qr-container-wally" class="qr-box" style="display: none;">
                            <h4>Escanea el QR Oficial DeporZone:</h4>
                            <div class="qr-code-placeholder"><span>[ 📷 ESCANEA QR WALLY ]</span></div>
                            <p>Monto a transferir: <span id="monto-qr-wally">0.00</span> Bs</p>
                            <button class="confirm-btn" data-sport="wally">✔ Confirmar Pago Individual</button>
                        </div>
                    </div>

                    <!-- Botón para Finalizar y Registrar Reserva -->
                    <div class="finalizar-container">
                        <button id="btn-finalizar-wally" class="btn-finalizar-reserva">🏆 Terminar y Registrar Reserva de Wally</button>
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= SECCIÓN DE FUTSAL ================= -->
        <section id="futsal" class="content-section theme-futsal" style="display: none;">
            <div class="sport-container">
                <div class="accordion-btn">⚽ <span>ARENA FUTSAL</span> - Panel de Control</div>
                
                <div class="accordion-panel">
                    
                    <div class="reserva-meta-box">
                        <div class="meta-field">
                            <label>📅 Fecha de Partido:</label>
                            <input type="date" id="fecha-futsal">
                        </div>
                        <div class="meta-field">
                            <label>⏰ Hora de Inicio:</label>
                            <input type="time" id="hora-futsal">
                        </div>
                    </div>

                    <div class="cancha-unica">
                        <div class="badge-sport">⚽ Césped Sintético Pro</div>
                        <img src="img/vol/CANCHA.jpeg" alt="Cancha Futsal">
                        <p class="descripcion-cancha">Cancha sintética profesional de césped alto, arcos reglamentarios e iluminación LED óptima para torneos 5v5 y 6v6.</p>
                    </div>

                    <div class="config-precio">
                        <label>💵 Precio Total del Ambiente (Bs):</label>
                        <input type="number" id="input-precio-futsal" value="120" min="10" step="5">
                    </div>

                    <div class="info-box">
                        <p><strong>Cupos Ocupados:</strong> <span id="total-jugadores-futsal">0</span> / 16 (Máx.)</p>
                        <p><strong>Cuota por Jugador:</strong> <span id="cuota-persona-futsal">0.00</span> Bs</p>
                    </div>

                    <div class="input-group">
                        <input type="text" id="nombre-jugador-futsal" placeholder="Nombre del integrante..." maxlength="30">
                        <button id="btn-anotar-futsal">➕ Añadir a Lista</button>
                    </div>

                    <ul id="lista-jugadores-futsal" class="player-list"></ul>

                    <div class="payment-section">
                        <h3>💳 Métodos de Pago Habilitados</h3>
                        <div class="payment-options">
                            <button class="pay-btn" data-sport="futsal" data-method="qr">📲 Pagar con QR Bancario</button>
                            <button class="pay-btn" data-sport="futsal" data-method="efectivo">💵 Efectivo en Cancha</button>
                        </div>
                        <div id="qr-container-futsal" class="qr-box" style="display: none;">
                            <h4>Escanea el QR Oficial DeporZone:</h4>
                            <div class="qr-code-placeholder"><span>[ 📷 ESCANEA QR FUTSAL ]</span></div>
                            <p>Monto a transferir: <span id="monto-qr-futsal">0.00</span> Bs</p>
                            <button class="confirm-btn" data-sport="futsal">✔ Confirmar Pago Individual</button>
                        </div>
                    </div>

                    <div class="finalizar-container">
                        <button id="btn-finalizar-futsal" class="btn-finalizar-reserva">🏆 Terminar y Registrar Reserva de Futsal</button>
                    </div>

                </div>
            </div>
        </section>

        <!-- ================= SECCIÓN DE VÓLEY ================= -->
        <section id="voley" class="content-section theme-voley" style="display: none;">
            <div class="sport-container">
                <div class="accordion-btn">🏐 <span>ARENA VÓLEY</span> - Panel de Control</div>
                
                <div class="accordion-panel">
                    
                    <div class="reserva-meta-box">
                        <div class="meta-field">
                            <label>📅 Fecha de Partido:</label>
                            <input type="date" id="fecha-voley">
                        </div>
                        <div class="meta-field">
                            <label>⏰ Hora de Inicio:</label>
                            <input type="time" id="hora-voley">
                        </div>
                    </div>

                    <div class="cancha-unica">
                        <div class="badge-sport">🏐 Red Profesional Ajustable</div>
                        <img src="img/vol/CANCHA.jpeg" alt="Cancha Vóley">
                        <p class="descripcion-cancha">Cancha multifuncional equipada con postes metálicos, bandas delimitadoras y <strong>red central ajustable</strong> profesional para alta competencia.</p>
                    </div>

                    <div class="config-precio">
                        <label>💵 Precio Total del Ambiente (Bs):</label>
                        <input type="number" id="input-precio-voley" value="80" min="10" step="5">
                    </div>

                    <div class="info-box">
                        <p><strong>Cupos Ocupados:</strong> <span id="total-jugadores-voley">0</span> / 16 (Máx.)</p>
                        <p><strong>Cuota por Jugador:</strong> <span id="cuota-persona-voley">0.00</span> Bs</p>
                    </div>

                    <div class="input-group">
                        <input type="text" id="nombre-jugador-voley" placeholder="Nombre del integrante..." maxlength="30">
                        <button id="btn-anotar-voley">➕ Añadir a Lista</button>
                    </div>

                    <ul id="lista-jugadores-voley" class="player-list"></ul>

                    <div class="payment-section">
                        <h3>💳 Métodos de Pago Habilitados</h3>
                        <div class="payment-options">
                            <button class="pay-btn" data-sport="voley" data-method="qr">📲 Pagar con QR Bancario</button>
                            <button class="pay-btn" data-sport="voley" data-method="efectivo">💵 Efectivo en Cancha</button>
                        </div>
                        <div id="qr-container-voley" class="qr-box" style="display: none;">
                            <h4>Escanea el QR Oficial DeporZone:</h4>
                            <div class="qr-code-placeholder"><span>[ 📷 ESCANEA QR VÓLEY ]</span></div>
                            <p>Monto a transferir: <span id="monto-qr-voley">0.00</span> Bs</p>
                            <button class="confirm-btn" data-sport="voley">✔ Confirmar Pago Individual</button>
                        </div>
                    </div>

                    <div class="finalizar-container">
                        <button id="btn-finalizar-voley" class="btn-finalizar-reserva">🏆 Terminar y Registrar Reserva de Vóley</button>
                    </div>

                </div>
            </div>
        </section>

    </main>

    <script src="script.js"></script>
</body>
</html>
